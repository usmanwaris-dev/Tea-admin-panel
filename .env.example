# ---- Tea Admin environment ----
# Copy to .env.local and fill in. The URL + anon key match the Tea mobile app's
# Supabase project. Get the service-role key from Supabase → Settings → API.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — NEVER prefix with NEXT_PUBLIC. Enables privileged admin writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# "mock" (seeded demo data, zero backend setup) | "live" (real Supabase).
NEXT_PUBLIC_DATA_SOURCE=mock

# Identity shown in demo/mock mode (no real auth).
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@getsnippet.co
